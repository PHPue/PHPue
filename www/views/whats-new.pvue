<!-- What's new in 0.0.3: each card shows the source and renders it live, right below. -->
<script>
    @require DemoHeader 'components/cards/DemoHeader.pvue';
    @require StatPill 'components/cards/StatPill.pvue';

    $t = Lang::pack();
    $features = Showcase::features();     // titles, notes and snippets in the current language
    $alsoFixed = Showcase::alsoFixed();

    // Data for the live demos (labels come from the language pack too)
    $bOnline = true;
    $nums    = range(1, 10);
    $groups  = [
        $t['demo_groupFruit'] => [$t['fruit_apple'], $t['fruit_pear']],
        $t['demo_groupVeg']   => [$t['demo_leek'], $t['demo_carrot']],
    ];
    $stats   = [
        ['label' => $t['demo_developers'], 'value' => '2500+'],
        ['label' => $t['demo_bundlers'],   'value' => '0'],
        ['label' => $t['demo_files'],      'value' => '2'],
    ];
    $total   = ['label' => $t['demo_release'], 'value' => PHPUE_VERSION];
    $nested  = ['stats' => ['developers' => 2500, 'label' => $t['demo_developers'], 'tags' => ['ssr', 'php']]];

    // Strings the browser needs, handed over through {{ }} in <cscript>
    $jsText = ['ranBad' => $t['demo_ranBad'], 'notCallable' => $t['demo_notCallable']];

    // 0.0.3: the method is enforced (a GET gets 405) and only @AJAX functions are callable
    @AJAX("POST")
    function whatsNewPing(array $input = []): void {
        header('Content-Type: application/json');
        echo json_encode(['pong' => true, 'method' => $_SERVER['REQUEST_METHOD']]);
    }

    // Not decorated, so ?action=whatsNewHidden falls through to the normal page
    function whatsNewHidden() {
        echo 'HIDDEN-FUNCTION-RAN';
    }
</script>

<header>
    <title>What's new in 0.0.3 | PHPue Example</title>
    <meta name="description" content="PHPue 0.0.3, demonstrated live: p-if anywhere, p-for over any iterable, component loops, enforced @AJAX methods and per-request html lang.">
</header>

