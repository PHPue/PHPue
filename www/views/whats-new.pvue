<cscript>
    const whatsNewText = {{ $jsText }};

    // Nested <template>: clone its content on demand
    function cloneToast() {
        const tpl = document.getElementById('toast-tpl');
        document.getElementById('toast-target').appendChild(tpl.content.cloneNode(true));
    }

    // @AJAX method enforcement, live
    async function pingAjax(kind) {
        const target = document.getElementById('ajax-result');
        let response;

        if (kind === 'POST') {
            response = await fetch('', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({action: 'whatsNewPing'})
            });
        } else if (kind === 'GET') {
            response = await fetch('?action=whatsNewPing');
        } else {
            response = await fetch('?action=whatsNewHidden');
        }

        const body = await response.text();
        const verdict = kind === 'HIDDEN'
            ? (body.trim().startsWith('HIDDEN-' + 'FUNCTION-RAN') ? whatsNewText.ranBad : whatsNewText.notCallable)
            : body.slice(0, 80);

        target.innerHTML = '';
        const status = document.createElement('strong');
        status.className = response.ok ? 'text-ue-mint' : 'text-rose-400';
        status.textContent = response.status + ' ';
        target.append(status, verdict);
    }

    // Array values straight from PHP
    const stats = {{ $nested['stats'] }};
    const first = {{ $stats[0] }};
    document.getElementById('cscript-result').textContent =
        'stats = ' + JSON.stringify(stats) + '\nfirst = ' + JSON.stringify(first);

    // Whatever phpue_set_lang() chose for this request
    document.getElementById('html-lang').textContent = document.documentElement.lang;
</cscript>
