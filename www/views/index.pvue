        ['step' => '02', 'tag' => 'Basics',        'title' => 'Your first app',       'text' => 'Views, components, p-if and p-for in a real page.',           'url' => 'https://phpue.co.uk/ue-tutorials?tutorialName=first-app'],
        ['step' => '03', 'tag' => 'Styling',       'title' => 'Styling your app',     'text' => 'Make it look the part with Tailwind and your own CSS.',       'url' => 'https://phpue.co.uk/ue-tutorials?tutorialName=styling-your-app'],
        ['step' => '04', 'tag' => 'Interactivity', 'title' => 'AlpineJS foundations', 'text' => 'Add client-side reactivity on top of server-rendered pages.', 'url' => 'https://phpue.co.uk/ue-tutorials?tutorialName=alpinejs-foundations'],
    ];

    $ecosystem = [
        ['title' => 'Extensions',         'text' => 'MetaControl for SEO, Matrix CMS, AlpineJS x-ssr and more.', 'url' => 'https://github.com/PHPue/PHPue-Extensions'],
        ['title' => 'Syntax Highlighter', 'text' => 'Proper .pvue highlighting for VS Code.',                     'url' => 'https://marketplace.visualstudio.com/items?itemName=PHPue.pvue-syntax'],
        ['title' => 'PHPue for AI',       'text' => 'LLM-ready docs so your AI assistant writes real PHPue.',     'url' => 'https://ai.phpue.co.uk/'],
    ];

    // Called from the form below with fetch(''). Handlers echo their response.
    @AJAX('POST')
    function welcomeGreet($input) {
        header('Content-Type: application/json');
        $name = trim((string) ($input['name'] ?? ''));
        $name = $name === '' ? 'friend' : mb_substr($name, 0, 40);

        echo json_encode([
            'message' => "Hello, $name!",
            'detail'  => 'Answered by PHP ' . PHP_VERSION . ' at ' . date('H:i:s') . ' via @AJAX.',
        ]);
    }
</script>

