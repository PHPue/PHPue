        ['title' => '@AJAX endpoints', 'text' => 'Decorate a PHP function and call it from fetch(). The form below is wired up this way.',
         'icon' => 'M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5'],
        ['title' => 'Plain PHP, always', 'text' => 'Autoloaded classes in backend/, raw PHP wherever you need it. No lock-in, no node_modules.',
