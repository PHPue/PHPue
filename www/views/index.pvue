<!-- Author: Edward Patch -->
<!-- The PHPue example app, rebuilt for 0.0.3. Every card on this page is a small, working demo. -->
<script>
    @require FruitCard 'components/cards/FruitCard.pvue';
    @require UserDetails 'components/dashboards/indexUserDetails.pvue';
    @require UserForm 'components/forms/indexForm.pvue';

    $t = Lang::pack();

    // --- Server snapshot (hero card) ---------------------------------------------------
    $serverFacts = [
        $t['fact_php']      => PHP_VERSION,
        $t['fact_phpue']    => PHPUE_VERSION,
        $t['fact_rendered'] => date('H:i:s'),
        $t['fact_language'] => Lang::SUPPORTED[Lang::code()],
    ];

    // --- Same maths, two runtimes ------------------------------------------------------
    $birthYear = 1995;
    $age = (int) date('Y') - $birthYear;

    // --- Session counter: survives a refresh because PHP keeps it -------------------------
    $btnCount = $_SESSION['btnCount'] ?? 0;

    // --- Fruit basket: p-for over components, and p-for + p-if on one element (0.0.3) ----
    $month = (int) date('n');
    $fruits = [
        ['key' => 'banana',     'emoji' => '🍌', 'tone' => 'from-amber-50 to-yellow-100 ring-amber-200',  'months' => range(1, 12)],
        ['key' => 'apple',      'emoji' => '🍎', 'tone' => 'from-rose-50 to-red-100 ring-rose-200',       'months' => [8, 9, 10, 11, 12]],
        ['key' => 'cherry',     'emoji' => '🍒', 'tone' => 'from-pink-50 to-rose-100 ring-pink-200',      'months' => [6, 7, 8]],
        ['key' => 'strawberry', 'emoji' => '🍓', 'tone' => 'from-red-50 to-rose-100 ring-red-200',        'months' => [5, 6, 7, 8, 9]],
        ['key' => 'blueberry',  'emoji' => '🫐', 'tone' => 'from-indigo-50 to-violet-100 ring-violet-200', 'months' => [6, 7, 8, 9]],
        ['key' => 'pear',       'emoji' => '🍐', 'tone' => 'from-lime-50 to-green-100 ring-lime-200',     'months' => [9, 10, 11, 12, 1]],
    ];
    foreach ($fruits as $i => $fruit) {
        $fruits[$i]['name'] = $t['fruit_' . $fruit['key']];
        $fruits[$i]['bInSeason'] = in_array($month, $fruit['months'], true);
    }
    $fruitNames = array_column($fruits, 'name');

    // --- Form demo state (the components below read these, no props needed) ------------
    $bFormOpen = $_SESSION['bFormOpen'] ?? false;
    $submitted = $_SESSION['subForm'] ?? null;

    // Strings the browser needs, handed over through {{ }} in <cscript>
    $jsText = [
        'count'   => $t['counter_count'],
        'clockAt' => $t['clock_at'],
        'error'   => $t['ajax_error'],
    ];

    // =========================== @AJAX handlers ===========================
    // 0.0.3: double quotes, typed parameters and return types all work, the declared
    // method is enforced (405 otherwise) and only @AJAX functions can be called.

    @AJAX("POST")
    function counterBump(array $input = []): void {
        header('Content-Type: application/json');
        $_SESSION['btnCount'] = ($_SESSION['btnCount'] ?? 0) + 1;
        echo json_encode(['count' => $_SESSION['btnCount']]);
    }

    @AJAX("POST")
    function counterReset(): void {
        header('Content-Type: application/json');
        $_SESSION['btnCount'] = 0;
        echo json_encode(['count' => 0]);
    }

    @AJAX('GET')
    function serverClock(): void {
        header('Content-Type: application/json');
        echo json_encode([
            'time'     => date('H:i:s'),
            'timezone' => date_default_timezone_get(),
            'php'      => PHP_VERSION,
        ]);
    }

    @AJAX('POST')
    function formToggle(): void {
        $_SESSION['bFormOpen'] = !($_SESSION['bFormOpen'] ?? false);
        echo json_encode(['open' => $_SESSION['bFormOpen']]);
    }

    @AJAX('POST')
    function formSubmit(array $input = []): void {
        header('Content-Type: application/json');
        $form = is_array($input['formData'] ?? null) ? $input['formData'] : [];
        $clean = fn($key, $max) => mb_substr(trim((string) ($form[$key] ?? '')), 0, $max);

        $submitted = [
            'name'       => $clean('name', 60),
            'email'      => $clean('email', 120),
            'fruit'      => $clean('favourite_fruit', 30),
            'message'    => $clean('message', 500),
            'newsletter' => !empty($form['newsletter']),
        ];

        if ($submitted['name'] === '' || !filter_var($submitted['email'], FILTER_VALIDATE_EMAIL)) {
            http_response_code(422);
            echo json_encode(['ok' => false, 'error' => Lang::t('form_invalid')]);
            return;
        }

        $_SESSION['subForm'] = $submitted;
        $_SESSION['bFormOpen'] = false;
        echo json_encode(['ok' => true]);
    }

    @AJAX('POST')
    function formClear(): void {
        unset($_SESSION['subForm']);
        echo json_encode(['ok' => true]);
    }
</script>

<header>
    <title>PHPue Example | v0.0.3</title>
    <meta name="description" content="The PHPue example app: server-side rendering, @AJAX, sessions, p-if and p-for, rebuilt for PHPue 0.0.3.">
    <meta name="keywords" content="PHP, Vue, PHPue, SSR, example">
    <meta name="author" content="Edward Patch">
</header>

<template>
    <main class="overflow-hidden">
        <!-- ============ Hero ============ -->
        <section class="relative">
            <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(#e2e8f0_1px,transparent_1px)] [background-size:22px_22px] [mask-image:radial-gradient(ellipse_at_top,black_30%,transparent_75%)]"></div>
            <div class="pointer-events-none absolute -top-40 left-1/2 -z-10 h-[34rem] w-[60rem] -translate-x-1/2 rounded-full bg-gradient-to-r from-ue-blue/20 via-ue-green/20 to-ue-amber/20 blur-3xl"></div>

            <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 pb-16 pt-14 sm:px-6 lg:grid-cols-[1.3fr_1fr] lg:pt-20">
                <div>
                    <a href="/whats-new" class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white/80 px-3 py-1 text-xs font-medium text-slate-600 shadow-sm backdrop-blur transition hover:border-slate-300">
                        <span class="h-1.5 w-1.5 rounded-full bg-ue-green"></span>
                        {{ $t['hero_badge'] }}
                        <span aria-hidden="true">&rarr;</span>
                    </a>

                    <h1 class="mt-6 text-4xl font-extrabold leading-[1.08] tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
                        {{ $t['hero_title'] }}<br>
                        <span class="bg-gradient-to-r from-ue-blue via-ue-green to-ue-amber bg-clip-text text-transparent">{{ $t['hero_titleAccent'] }}</span>
                    </h1>

                    <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600">{{ $t['hero_subtitle'] }}</p>

                    <div class="mt-8 flex flex-wrap gap-3">
                        <a href="#demos" class="rounded-full bg-slate-900 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-slate-900/20 transition hover:-translate-y-0.5 hover:bg-slate-800">{{ $t['hero_ctaDemos'] }}</a>
                        <a href="/whats-new" class="rounded-full border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-800 transition hover:-translate-y-0.5 hover:border-slate-400">{{ $t['hero_ctaNew'] }}</a>
                    </div>
                </div>

                <!-- Server snapshot: p-for with keys -->
                <div class="relative">
                    <div class="absolute -inset-3 -z-10 rounded-3xl bg-gradient-to-br from-ue-blue/15 to-ue-green/15 blur-xl"></div>
                    <div class="overflow-hidden rounded-2xl border border-slate-800 bg-slate-950 shadow-2xl">
                        <div class="flex items-center gap-1.5 border-b border-white/10 px-4 py-3">
                            <span class="h-2.5 w-2.5 rounded-full bg-rose-400/80"></span>
                            <span class="h-2.5 w-2.5 rounded-full bg-amber-400/80"></span>
                            <span class="h-2.5 w-2.5 rounded-full bg-emerald-400/80"></span>
                            <span class="ml-3 font-mono text-xs text-slate-500">{{ $t['hero_snapshot'] }}</span>
                        </div>
                        <dl class="divide-y divide-white/5 px-5 py-2 font-mono text-sm">
                            <div p-for="$label => $value in $serverFacts" class="flex items-center justify-between gap-4 py-2.5">
                                <dt class="text-slate-500">{{ $label }}</dt>
                                <dd class="text-emerald-300">{{ $value }}</dd>
                            </div>
                        </dl>
                        <p class="border-t border-white/10 px-5 py-3 text-xs text-slate-500">{{ $t['hero_snapshotNote'] }}</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ============ Live demos ============ -->
        <section id="demos" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-16 sm:px-6">
            <p class="text-sm font-semibold uppercase tracking-widest text-ue-green">{{ $t['demos_kicker'] }}</p>
            <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{{ $t['demos_title'] }}</h2>
            <p class="mt-3 max-w-2xl text-slate-600">{{ $t['demos_intro'] }}</p>

            <div class="mt-10 grid gap-5 md:grid-cols-2">
                <!-- Session counter -->
                <article class="flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                    <span class="w-fit rounded-full bg-ue-blue/10 px-2.5 py-0.5 font-mono text-xs font-medium text-ue-blue">@AJAX("POST") + $_SESSION</span>
                    <h3 class="mt-4 text-lg font-semibold">{{ $t['counter_title'] }}</h3>
                    <p class="mt-1 flex-1 text-sm text-slate-600">{{ $t['counter_text'] }}</p>
                    <div class="mt-6 flex flex-wrap items-center gap-3">
                        <button type="button" onclick="bumpCounter()" class="rounded-full bg-ue-blue px-5 py-2.5 text-sm font-semibold text-white shadow-sm shadow-ue-blue/30 transition hover:bg-ue-navy active:scale-95">
                            {{ $t['counter_count'] }}: <span id="btnCounter" class="tabular-nums">{{ $btnCount }}</span>
                        </button>
                        <button type="button" onclick="resetCounter()" class="rounded-full border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-slate-400">{{ $t['counter_reset'] }}</button>
                    </div>
                </article>

                <!-- Server clock -->
                <article class="flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                    <span class="w-fit rounded-full bg-ue-green/10 px-2.5 py-0.5 font-mono text-xs font-medium text-emerald-700">@AJAX('GET') &middot; ?action=serverClock</span>
                    <h3 class="mt-4 text-lg font-semibold">{{ $t['clock_title'] }}</h3>
                    <p class="mt-1 flex-1 text-sm text-slate-600">{{ $t['clock_text'] }}</p>
                    <div class="mt-6 flex flex-wrap items-center gap-4">
                        <button type="button" onclick="askServerClock()" class="rounded-full bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-800 active:scale-95">{{ $t['clock_button'] }}</button>
                        <span id="serverClock" class="font-mono text-sm text-slate-500">&mdash;</span>
                    </div>
                </article>

                <!-- Same maths, two runtimes -->
                <article class="min-w-0 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                    <span class="w-fit rounded-full bg-ue-amber/15 px-2.5 py-0.5 font-mono text-xs font-medium text-amber-700">&#123;&#123; $age &#125;&#125; vs JavaScript</span>
                    <h3 class="mt-4 text-lg font-semibold">{{ $t['age_title'] }}</h3>
                    <p class="mt-1 text-sm text-slate-600">{{ $t['age_text'] }} {{ $birthYear }}.</p>
                    <div class="mt-6 grid grid-cols-2 gap-3">
                        <div class="rounded-xl border-l-4 border-ue-blue bg-slate-50 p-4">
                            <p class="text-xs font-semibold uppercase tracking-wide text-ue-blue">{{ $t['age_php'] }}</p>
                            <p class="mt-1 text-3xl font-bold tabular-nums text-slate-800">{{ $age }}</p>
                        </div>
                        <div class="rounded-xl border-l-4 border-pink-500 bg-slate-50 p-4">
                            <p class="text-xs font-semibold uppercase tracking-wide text-pink-600">{{ $t['age_js'] }}</p>
                            <p class="mt-1 text-3xl font-bold tabular-nums text-slate-800"><span id="jsAge">&hellip;</span></p>
                        </div>
                    </div>
                </article>

                <!-- PHP to JS bridge -->
                <article class="min-w-0 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                    <span class="w-fit rounded-full bg-violet-100 px-2.5 py-0.5 font-mono text-xs font-medium text-violet-700">&lt;cscript&gt; &#123;&#123; $fruitNames &#125;&#125;</span>
                    <h3 class="mt-4 text-lg font-semibold">{{ $t['bridge_title'] }}</h3>
                    <p class="mt-1 text-sm text-slate-600">{{ $t['bridge_text'] }}</p>
                    <pre id="fruitJson" class="mt-6 overflow-x-auto rounded-xl bg-slate-950 p-4 font-mono text-[13px] leading-relaxed text-emerald-300"></pre>
                </article>
            </div>
        </section>

        <!-- ============ Fruit basket ============ -->
        <section class="border-y border-slate-200 bg-slate-50/70">
            <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
                <div class="flex flex-wrap items-end justify-between gap-4">
                    <div>
                        <p class="text-sm font-semibold uppercase tracking-widest text-ue-green">p-for &middot; components</p>
                        <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{{ $t['basket_title'] }}</h2>
                        <p class="mt-3 max-w-2xl text-slate-600">{{ $t['basket_intro'] }}</p>
                    </div>
                    <p class="rounded-full bg-white px-4 py-1.5 text-sm font-medium text-slate-600 shadow-sm ring-1 ring-slate-200">
                        <span class="font-mono font-semibold text-slate-900">{{ count($fruits) }}</span> {{ $t['basket_count'] }}
                    </p>
                </div>

                <!-- 0.0.3: p-for straight on a component tag. FruitCard reads $fruit from this loop. -->
                <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
                    <FruitCard p-for="$fruit in $fruits" />
                </div>

                <!-- 0.0.3: p-for + p-if on one element loops first, then filters -->
                <div class="mt-8 flex flex-wrap items-center gap-2 text-sm">
                    <span class="font-semibold text-slate-700">{{ $t['basket_inSeason'] }}</span>
                    <span p-for="$fruit in $fruits" p-if="$fruit['bInSeason']" class="rounded-full bg-emerald-100 px-3 py-1 font-medium text-emerald-800">{{ $fruit['emoji'] }} {{ $fruit['name'] }}</span>
                    <code class="ml-auto hidden rounded bg-white px-2 py-1 font-mono text-xs text-slate-500 ring-1 ring-slate-200 md:inline">p-for="$fruit in $fruits" p-if="$fruit['bInSeason']"</code>
                </div>
            </div>
        </section>

        <!-- ============ Form demo ============ -->
        <section id="form" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-16 sm:px-6">
            <div class="mx-auto max-w-3xl text-center">
                <p class="text-sm font-semibold uppercase tracking-widest text-ue-green">@AJAX &middot; $_SESSION &middot; p-if</p>
                <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{{ $t['form_title'] }}</h2>
                <p class="mt-3 text-slate-600">{{ $t['form_intro'] }}</p>

                <button p-if="!$bFormOpen" type="button" onclick="toggleForm()" class="mt-8 inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-ue-blue to-ue-navy px-7 py-3.5 font-semibold text-white shadow-lg shadow-ue-blue/30 transition hover:-translate-y-0.5">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                    {{ $t['form_open'] }}
                </button>
            </div>

            <!-- 0.0.3: p-if on a component tag. Both components see $submitted, $fruits and $t. -->
            <div class="mx-auto mt-10 max-w-3xl">
                <UserDetails p-if="$submitted && !$bFormOpen" />
                <UserForm p-if="$bFormOpen" />
            </div>
        </section>
    </main>
</template>

<cscript>
    const phpueText = {{ $jsText }};

    async function phpuePost(action, extra = {}) {
        const response = await fetch('', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({action, ...extra})
        });
        return response;
    }

    // --- Session counter: PHP owns the number, the page just shows it ---
    async function bumpCounter() {
        try {
            const data = await (await phpuePost('counterBump')).json();
            document.getElementById('btnCounter').textContent = data.count;
        } catch (error) {
            console.log(phpueText.error, error);
        }
    }

    async function resetCounter() {
        try {
            const data = await (await phpuePost('counterReset')).json();
            document.getElementById('btnCounter').textContent = data.count;
        } catch (error) {
            console.log(phpueText.error, error);
        }
    }

    // --- GET handler: plain query string, no body ---
    async function askServerClock() {
        const target = document.getElementById('serverClock');
        try {
            const data = await (await fetch('?action=serverClock')).json();
            target.textContent = `${data.time} (${data.timezone}) ${phpueText.clockAt} PHP ${data.php}`;
        } catch (error) {
            target.textContent = phpueText.error;
        }
    }

    // --- Same maths in the browser ---
    document.getElementById('jsAge').textContent = new Date().getFullYear() - {{ $birthYear }};

    // --- PHP array, injected as JSON ---
    const fruitNames = {{ $fruitNames }};
    document.getElementById('fruitJson').textContent = 'const fruitNames = ' + JSON.stringify(fruitNames, null, 2) + ';';

    // --- Form flow: toggling is stored in the session, then the page re-renders on the server ---
    async function toggleForm() {
        try {
            const response = await phpuePost('formToggle');
            if (response.ok) window.location.reload();
        } catch (error) {
            console.log(phpueText.error, error);
        }
    }

    async function clearDetails() {
        try {
            const response = await phpuePost('formClear');
            if (response.ok) window.location.reload();
        } catch (error) {
            console.log(phpueText.error, error);
        }
    }
</cscript>
