<cscript>
    const greetForm = document.getElementById('greet-form');

    greetForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const button = greetForm.querySelector('button');
        button.disabled = true;

        try {
            const response = await fetch('', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: 'welcomeGreet', name: document.getElementById('greet-name').value })
            });
            const data = await response.json();
            document.getElementById('greet-message').textContent = data.message;
            document.getElementById('greet-detail').textContent = data.detail;
            document.getElementById('greet-result').classList.remove('hidden');
        } catch (error) {
            console.error('welcomeGreet failed', error);
        } finally {
            button.disabled = false;
        }
    });
</cscript>
