<!-- Author: Edward Patch -->
<!-- PHPue 0.0.3 bug-fix test bench: every section below exercises one 0.0.2 bug; the client-side
     checker at the bottom marks each test PASS/FAIL. Open /fixes (also after `php index.php build`). -->
<script>
    // A literal <header> and <template> in a PHP comment: 0.0.2 treated them as the real blocks.
    @require FixBadge 'components/tests/FixBadge.pvue';

    $bShow   = true;
    $tone    = 'bg-emerald-400/15';
    $items   = ['Alpha', 'Beta', 'Gamma'];
    $numbers = [1, 2, 3, 4, 5, 6];
    $groups  = ['Fruit' => ['apple', 'pear'], 'Veg' => ['leek']];
    $data    = ['nested' => ['value' => 42, 'label' => 'from PHP']];

    // A normal PHP function: 0.0.2's dispatcher would run ANY function named in ?action=
    function fixesSecret() { echo 'SECRET-RAN'; }

    @AJAX('POST')
    function fixesPostOnly($input) {
        header('Content-Type: application/json');
        echo json_encode(['ok' => true, 'method' => $_SERVER['REQUEST_METHOD']]);
    }
</script>

<header>
    <title>0.0.3 Test Bench | PHPue</title>
    <!-- a <title> inside a comment no longer becomes the page title -->
    <meta name="lang" content="en-GB">
</header>

<template>
    <main class="mx-auto max-w-6xl px-4 py-12 sm:px-6" id="fixes">
