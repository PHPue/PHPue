<cscript>
    // 0.0.3: {{ }} in cscript accepts any $expression, not just a variable name
    const nestedValue = {{ $data['nested']['value'] }};
    const nestedLabel = {{ $data['nested']['label'] }};

    (async function () {
        const $ = (s) => document.querySelector(s);
        const results = [];
        const check = (n, name, ok) => results.push({ n, name, ok: !!ok });

        check(1, 'single-line p-if renders, false one omitted', $('#t1') && !$('#t1-neg'));
        check(2, 'mustache in p-if element attributes', $('#t2')?.classList.contains('bg-emerald-400/15') && $('#t2-after') && !$('#t2').contains($('#t2-after')));
        check(3, 'same-tag children inside p-if', $('#t3')?.children.length === 3 && $('#t3-after') && !$('#t3').contains($('#t3-after')));
        check(4, 'same tag nested in p-for', document.querySelectorAll('#t4 > .t4-item').length === 3 && [...document.querySelectorAll('.t4-item')].every(e => e.querySelectorAll('.t4-inner').length === 1) && $('#t4-after')?.parentElement.id === 't4');
        check(5, 'p-for + p-if on one element', [...document.querySelectorAll('.t5')].map(e => e.textContent.trim()).join(',') === '2,4,6');
        check(6, 'p-for over range() and ArrayIterator', document.querySelectorAll('.t6-range').length === 3 && [...document.querySelectorAll('.t6-iter')].map(e => e.textContent.trim()).join(',') === 'a=1,b=2');
        check(7, "'>' / '=>' in attributes, single-quoted p-if", $('#t7')?.dataset.rule === 'a > b' && $('#t7')?.dataset.js === 'items.map(i => i)');
        check(8, 'mustache count() / strtoupper() / literal item.name', $('#t8-count')?.textContent === '3' && $('#t8-upper')?.textContent === 'PHPUE' && $('#t8-literal')?.textContent === '{{ item.name }}');
        const tpl = $('#t9-tpl'); if (tpl) $('#t9-target').append(tpl.content.cloneNode(true));
        check(9, 'nested <template> element kept (rest of page intact)', $('#t9-target .t9-clone') && $('#fix-results'));
        check(10, 'bare <header> element kept in template', $('header#t10'));
        check(11, '<FixBadge /> (spaced, nested folder) rendered', $('[data-test="11"] .fix-badge')?.textContent.trim() === 'nested component');
        check(12, 'void element with p-if', $('#t12')?.value === 'void ok');
        check(13, 'nested p-for (key => value outer, inner reads outer)', document.querySelectorAll('#t13 > .t13-group').length === 2 && [...document.querySelectorAll('.t13-item')].map(e => e.textContent.trim()).join(',') === 'Fruit:apple,Fruit:pear,Veg:leek' && [...document.querySelectorAll('.t13-group')].every(g => g.querySelectorAll('.t13-item').length >= 1) && $('#t13-after')?.parentElement.id === 't13');
        check(14, 'title from header block (comment ignored)', document.title === '0.0.3 Test Bench | PHPue');
        check(15, '<html lang> from view meta at runtime', document.documentElement.lang === (new URLSearchParams(location.search).get('lang') || 'en-GB'));
        check(16, 'cscript mustache with $data[..] expression', nestedValue === 42 && nestedLabel === 'from PHP');
        check(17, 'App header mustache with $appMeta[..]', document.querySelector('meta[name="generator"]')?.content === 'PHPue 0.0.3');

        // AJAX rules (live requests)
        const post = (body) => fetch(location.pathname, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        try {
            const ping = await post({ action: 'fixComponentPing', value: 'hi' }).then(r => r.json());
            check(18, 'component @AJAX("POST") with return type', ping.pong === true && ping.echo === 'hi');
        } catch (e) { check(18, 'component @AJAX("POST") with return type', false); }
        const wrongMethod = await fetch(location.pathname + '?action=fixesPostOnly');
        check(19, 'declared method enforced (GET → 405)', wrongMethod.status === 405);
        const okMethod = await post({ action: 'fixesPostOnly' });
        check(20, 'declared method accepted (POST → 200)', okMethod.status === 200 && (await okMethod.json()).ok === true);
        const notAjax = await fetch(location.pathname + '?action=fixesSecret').then(r => r.text());
        check(21, 'non-@AJAX function not callable via ?action=', !notAjax.includes('SECRET' + '-RAN') && notAjax.includes('0.0.3 Test Bench'));
        const builtin = await fetch(location.pathname + '?action=phpinfo').then(r => r.text());
        check(22, 'PHP built-ins not callable via ?action=', !builtin.includes('PHP ' + 'License') && builtin.includes('0.0.3 Test Bench'));

        const passed = results.filter(r => r.ok).length;
        const allPassed = passed === results.length;
        const pill = (ok) => 'shrink-0 rounded-full px-2.5 py-0.5 text-xs font-semibold ' + (ok ? 'bg-emerald-400/15 text-emerald-300 ring-1 ring-inset ring-emerald-400/30' : 'bg-red-400/15 text-red-300 ring-1 ring-inset ring-red-400/30');
        $('#fix-summary').textContent = `${passed}/${results.length} checks passed`;
        $('#fix-summary').className = allPassed ? 'text-emerald-400' : 'text-red-400';
        $('#fix-progress').style.width = `${(passed / results.length) * 100}%`;
        if (!allPassed) $('#fix-progress').classList.replace('bg-emerald-400', 'bg-red-400');

        for (const r of results) {
            const status = document.querySelector(`[data-status="${r.n}"]`);
            if (status) {
                // fixture card: badge in its header, red outline on failure
                status.textContent = r.ok ? 'PASS' : 'FAIL';
                status.className = pill(r.ok);
                if (!r.ok) document.querySelector(`[data-card="${r.n}"]`).classList.replace('border-white/10', 'border-red-400/60');
                continue;
            }
            const li = document.createElement('li');
            li.className = 'flex items-center gap-3 px-4 py-3';
            li.innerHTML = `<span class="w-6 font-mono text-xs text-slate-400">${r.n}</span><span class="flex-1 text-slate-200"></span><span class="${pill(r.ok)}">${r.ok ? 'PASS' : 'FAIL'}</span>`;
            li.children[1].textContent = r.name;
            $('#fix-results').append(li);
        }
        window.__phpueFixes = { passed, total: results.length, failed: results.filter(r => !r.ok).map(r => r.n + ' ' + r.name) };
    })();
</cscript>
