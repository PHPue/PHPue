                    <section class="fix" data-test="11"><?php $badgeLabel = 'nested component'; ?><FixBadge /></section>
                </div>
            </article>
            <article class="flex flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-5 transition-colors" data-card="12">
                <div class="flex items-start gap-3">
                    <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-white/10 font-mono text-xs font-semibold text-slate-200">12</span>
                    <div class="min-w-0 flex-1">
                        <h2 class="font-semibold leading-7 text-white">Void element with p-if</h2>
                        <p class="mt-0.5 text-sm text-slate-400"><code>&lt;input&gt;</code> has no closing tag to search for.</p>
                    </div>
                    <span data-status="12" class="shrink-0 rounded-full bg-white/10 px-2.5 py-0.5 text-xs font-semibold text-slate-300">&hellip;</span>
