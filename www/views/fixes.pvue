                <div class="mt-4 flex-1 rounded-xl border border-white/10 bg-black/30 p-3 font-mono text-[13px] leading-relaxed text-slate-200">
                    <section class="fix" data-test="12"><input p-if="$bShow" id="t12" value="void ok" readonly class="rounded border border-white/15 bg-ink-950 px-2 text-slate-100"></section>
                </div>
            </article>
            <article class="flex flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-5 transition-colors" data-card="13">
                <div class="flex items-start gap-3">
                    <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-white/10 font-mono text-xs font-semibold text-slate-200">13</span>
                    <div class="min-w-0 flex-1">
                        <h2 class="font-semibold leading-7 text-white">Nested p-for</h2>
                        <p class="mt-0.5 text-sm text-slate-400">Inner loop reads the outer item. 0.0.2 left the inner <code>php-for</code> raw.</p>
                    </div>
                    <span data-status="13" class="shrink-0 rounded-full bg-white/10 px-2.5 py-0.5 text-xs font-semibold text-slate-300">&hellip;</span>
                </div>
                <div class="mt-4 flex-1 rounded-xl border border-white/10 bg-black/30 p-3 font-mono text-[13px] leading-relaxed text-slate-200">
                    <section class="fix space-y-2" data-test="13" id="t13">
                        <div p-for="$groupName => $entries in $groups" class="t13-group">
                            <span class="t13-name font-semibold">{{ $groupName }}</span>
                            <ul class="ml-4 list-disc"><li p-for="$entry in $entries" class="t13-item">{{ $groupName }}:{{ $entry }}</li></ul>
                        </div>
                        <div id="t13-after" class="text-slate-400">after the outer loop</div>
                    </section>
                </div>
            </article>
        </div>

        <h2 class="mt-12 font-mono text-sm font-semibold uppercase tracking-widest text-slate-400">Runtime, header and @AJAX</h2>
        <ul id="fix-results" class="mt-4 divide-y divide-white/10 overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] text-sm"></ul>
