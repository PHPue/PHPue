<!-- Used as <?php $demo = 'pif'; ?><DemoHeader/>: set a variable, then drop the component in.
     Reads $features, $demo and $t from the parent view. -->
<script>
    $feature = $features[$demo];
    $demoNumber = array_search($demo, array_keys($features), true) + 1;
</script>

<template>
    <div class="flex items-start gap-3">
        <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-ue-sky/15 font-mono text-xs font-semibold text-ue-sky ring-1 ring-ue-sky/30">{{ $demoNumber }}</span>
        <div class="min-w-0 flex-1">
            <h3 class="font-semibold leading-7 text-white">{{ $feature['title'] }}</h3>
            <p class="mt-0.5 text-sm text-slate-400">{{ $feature['before'] }}</p>
        </div>
    </div>
    <p class="mt-4 text-[11px] font-semibold uppercase tracking-widest text-slate-500">{{ $t['new_source'] }}</p>
    <pre class="mt-1.5 overflow-x-auto rounded-xl border border-white/10 bg-ink-950 p-4 font-mono text-[12.5px] leading-relaxed text-slate-200 [font-variant-ligatures:none]"><code>{{ $feature['code'] }}</code></pre>
    <p class="mt-4 text-[11px] font-semibold uppercase tracking-widest text-slate-500">{{ $t['new_result'] }}</p>
</template>
